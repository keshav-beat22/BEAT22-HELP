# Public base URL, used for canonicals, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://help.beat22.com

# --- Keystatic admin (/admin) --------------------------------------------
# Only needed for the hosted CMS. Until all three are set, the admin falls
# back to local mode and the site still builds and deploys normally.
# Generated by the setup wizard at https://help.beat22.com/keystatic/setup
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
