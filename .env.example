# Public base URL, used for canonicals, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://help.beat22.com

# --- Admin access gate ----------------------------------------------------
# A shared code required before /admin, /keystatic or /api/keystatic will
# respond at all. It is a second factor in front of the identity check, not a
# replacement for it — passing the gate grants nothing on its own.
#
# There is no rate limiting at the edge, so make it long and random rather
# than memorable:  openssl rand -base64 24
#
# Unset means locked, not open: the gate page will say it is unconfigured.
ADMIN_ACCESS_CODE=

# --- Keystatic admin (/admin) --------------------------------------------
# Generated by the setup wizard, which only runs locally:
#   npm run dev   ->   http://localhost:3000/keystatic/setup
# Keystatic refuses to complete setup outside development, and the wizard
# writes the four values below straight into .env (gitignored).
#
# Copy the same four into Vercel (Production, Preview and Development) and
# redeploy — NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG is compiled into the client
# bundle, so it only takes effect on a rebuild.
#
# Until all four are set the public site builds and serves normally; only
# /api/keystatic/* reports the misconfiguration.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
